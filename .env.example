# Токен сообщества (Управление → Работа с API → Ключи доступа).
# Права: управление сообществом + сообщения сообщества.
VK_TOKEN=Управление → Работа с API → Ключи доступа → «Создать ключ». Права: управление сообществом + сообщения сообщества.

# Числовой id сообщества (без минуса), например 123456789.
VK_GROUP_ID=https://vk.ru/club*********?act=api тебе нужно то что вместо звёздочек

# longpoll — для локального запуска, callback — для продакшена.
BOT_TRANSPORT=longpoll
VK_API_VERSION=5.199

# Callback API (нужно только для BOT_TRANSPORT=callback)
VK_CONFIRMATION_CODE=Управление → Работа с API → Callback API → Настройки сервера, поле «Строка, которую должен вернуть сервер».
VK_SECRET_KEY=секретный ключ из того же раздела, поле «Секретный ключ». Если поле пустое, задай там свой ключ и сохрани настройки.
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=8080
CALLBACK_PATH=/vk/callback

LOG_LEVEL=INFO
# 1 — показывать сырые HTTP-запросы (коды 200 и т.п.)
LOG_HTTP=0
